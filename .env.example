# ═══════════════════════════════════════════════════════════════
# 小說工坊 Novel Forge - 環境變數設定
# ═══════════════════════════════════════════════════════════════

# 服務設定
HOST=0.0.0.0
PORT=8012
DEBUG=false

# LLM 設定
# 支援 OpenAI 相容 API（OpenAI / DeepSeek / Ollama / LM Studio 等）
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o

# 生成設定
LLM_TEMPERATURE=0.8
# 中文 3000 字/章 約需 4500+ tokens，太低會截斷章節
LLM_MAX_TOKENS=8192

# 預設風格
DEFAULT_STYLE=modern

# 去AI味設定
ANTI_AI_ENABLED=true
ANTI_AI_STRENGTH=1.0

# 資料庫（預設使用 SQLite）
# DATABASE_URL=sqlite+aiosqlite:///./data/novels.db

# ═══════════════════════════════════════════════════════════════
# 範例：使用 DeepSeek
# ═══════════════════════════════════════════════════════════════
# LLM_API_BASE=https://api.deepseek.com
# LLM_API_KEY=your_deepseek_key
# LLM_MODEL=deepseek-chat

# ═══════════════════════════════════════════════════════════════
# 範例：使用本地 Ollama
# ═══════════════════════════════════════════════════════════════
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3
